import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.util.Map;

/**
 * Teaches the game about the new 2D figure, before the game starts: its name goes into the game's entity list (so saved worlds can load
 * it) and its drawing code into the render manager. Called by the Orrin loader by name (it can't be named from the loader's own package).
 */
public class OrrinSprites_@TAG@ {
    public static void register() throws Exception {
        Method add = Class.forName("@ENTITYLIST@").getDeclaredMethod("@REGISTERMETHOD@", Class.class, String.class);
        add.setAccessible(true);
        add.invoke(null, OrrinSprite_@TAG@.class, "OrrinSprite");
        Field renderers = @RENDERMANAGER@.class.getDeclaredField("@MANAGERMAP@");
        renderers.setAccessible(true);
        OrrinSpriteRender_@TAG@ render = new OrrinSpriteRender_@TAG@();
        @SuppressWarnings("unchecked")
        Map<Class<?>, Object> map = (Map<Class<?>, Object>) renderers.get(@RENDERMANAGER@.@MANAGERINSTANCE@);
        map.put(OrrinSprite_@TAG@.class, render);
        render.@RENDERSETMANAGER@(@RENDERMANAGER@.@MANAGERINSTANCE@);
    }
}
