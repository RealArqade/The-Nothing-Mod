    "message.the-nothing-mod.kicked":  "You shouldn\u0027t have looked back.",
    "disclaimer.the-nothing-mod.title":  "Content Warning",
    "disclaimer.the-nothing-mod.body":  "This mod is a horror experience. It contains jump scares with sudden loud sounds, unsettling imagery, and flashing, glitching and flickering visuals. If you are photosensitive, prone to seizures, or easily startled, please be careful, or do not continue.\n\nSomething may appear in your world without warning, and it can end your game. You may be disconnected from your world, and your character may die. In Hardcore mode, dying is permanent and the world is lost. The disconnect can be turned off in the mod\u0027s settings; the death cannot.\n\nRarely, a fake blue screen fills the game for about 20 seconds (it is only a picture and ends by itself; Alt+F4 three times closes the game), and the game may crash on purpose after saving. Both can be switched off in the mod\u0027s settings.\n\nThe mod may leave a few short plain text notes on your Desktop, and may show you details it reads from your own computer (like your user name). Those details are only ever shown to you, on your own screen or in those notes. They are never sent anywhere. Word0946 Mode switches both off.\n\nBack up any world you care about before playing. You play at your own risk.",
    "disclaimer.the-nothing-mod.page2.title":  "Disclaimer",
    "disclaimer.the-nothing-mod.next":  "Next",
    "disclaimer.the-nothing-mod.back":  "Back",
    "disclaimer.the-nothing-mod.bullet.0":  "This mod is provided for **entertainment purposes only**.",
    "disclaimer.the-nothing-mod.bullet.1":  "The mod is a **fictional work** intended to create psychological horror experiences within Minecraft.",
    "disclaimer.the-nothing-mod.bullet.2":  "This mod creates files, but does not harm your system in any way.",
    "disclaimer.the-nothing-mod.bullet.3":  "The creator is **not responsible for any emotional distress, discomfort, or other effects** that may occur from playing this mod.",
    "disclaimer.the-nothing-mod.bullet.4":  "The mod may simulate system corruption or blue-screen effects — but these are all **visual/audio illusions** inside the game. File creation, however, is not inside of the game. You may find files appear on your Desktop. They are part of the lore.",
    "disclaimer.the-nothing-mod.bullet.5":  "**Word0946 Mode** is opt-in and can be switched off at any time. Most other effects can be switched off in the settings too. A few can\u0027t: the monsters can still kill you, and the Quit Game button stays greyed out (Alt+F4 and the window\u0027s close button always work).",
    "disclaimer.the-nothing-mod.dev_hint":  "Development build: press SPACE to skip this screen.",
    "disclaimer.the-nothing-mod.acknowledge":  "I have read and understand this warning.",
    "disclaimer.the-nothing-mod.dont_show_again":  "Don\u0027t show again",
    "config.the-nothing-mod.show_disclaimer.name":  "Show content warning on launch",
    "config.the-nothing-mod.show_disclaimer.description":  "Shows the content warning every time the game starts. Turn it back on here if you chose Don\u0027t show again.",
    "menu.the-nothing-mod.quit_disabled":  "Not yet.",
    "config.the-nothing-mod.disable_quit.name":  "Disable the Quit Game button",
    "config.the-nothing-mod.disable_quit.description":  "Greys out Quit Game on the title screen. Only dev Word0908 and dev mode can turn this off; everyone else closes the game with Alt+F4, Cmd+Q or the window\u0027s close button.",
    "config.the-nothing-mod.Word0946.name":  "Word0946 Mode",
    "config.the-nothing-mod.Word0946.description":  "For streaming safely: switches off the Desktop notes and everything that shows details from your computer (your user name and so on), so none of it can end up on stream.",
    "config.the-nothing-mod.tone_down.name":  "Tone down the jumpscare",
    "config.the-nothing-mod.tone_down.description":  "For photosensitivity or sensitive ears: removes the flashes, calms the shaking and static, and plays the sound at 40% volume. The jumpscare still happens.",
    "config.the-nothing-mod.dev.jumpscare.name":  "Test jumpscare",
    "config.the-nothing-mod.dev.jumpscare.description":  "Plays the jumpscare right now, so you can test it without being caught. Dev builds only.",
    "config.the-nothing-mod.kick.name":  "Disconnect when caught",
    "config.the-nothing-mod.kick.description":  "When it catches you, you are disconnected from the world and are dead when you come back. Turn this off and you simply die on the spot instead. There is no setting that stops the death itself.",
    "config.the-nothing-mod.title":  "The Nothing Mod",
    "config.the-nothing-mod.general":  "General",
    "config.the-nothing-mod.high_res.name":  "High-Word0765 textures",
    "config.the-nothing-mod.high_res.description":  "Use the detailed 64x64 textures for the block. Turn off for the 16x16 ones. Takes effect when you save (resources reload, no restart).",
    "config.the-nothing-mod.dev":  "Dev tools",
    "config.the-nothing-mod.dev.tooltip":  "Only exists in a development environment. Saving writes the values into src/main/resources so the next build ships them.",
    "config.the-nothing-mod.dev.color.name":  "Dust colour",
    "config.the-nothing-mod.dev.color.description":  "Tint applied to the grayscale dust textures. Chunks reload when you save.",
    "config.the-nothing-mod.dev.conducts.name":  "Conducts redstone",
    "config.the-nothing-mod.dev.conducts.description":  "Off: purely decorative, never carries a signal. On: carries a signal like vanilla redstone dust. Dust that is already placed keeps its old state until it updates, so break and re-place to test.",
    "config.the-nothing-mod.dev.powered_color.name":  "Powered colour",
    "config.the-nothing-mod.dev.powered_color.description":  "Colour at full signal strength; weaker signals fade between the normal colour and this. Greyed out while the dust doesn\u0027t conduct redstone.",
    "config.the-nothing-mod.dev.reset_powered_color.name":  "Reset powered colour",
    "config.the-nothing-mod.dev.reset_powered_color.description":  "Sets the powered colour to a brighter version of the normal colour above.",
    "config.the-nothing-mod.dev.powers_diagonally.name":  "Power diagonally",
    "config.the-nothing-mod.dev.powers_diagonally.description":  "Powered dust also powers pistons, lamps and other components diagonally next to it. A dust only powers the diagonals it isn\u0027t already pointing along: an isolated dot powers all four, a straight line none. Greyed out while the dust doesn\u0027t conduct redstone.",
    "config.the-nothing-mod.dev.diagonals.name":  "Connect diagonally",
    "config.the-nothing-mod.dev.diagonals.description":  "Link to dust on the diagonal. Only affects dust that gets updated afterwards, so break and re-place to test.",
    "config.the-nothing-mod.dev.log.name":  "Log connections",
    "config.the-nothing-mod.dev.log.description":  "Print every connection state the dust block works out to the game log.",
    "config.the-nothing-mod.dev.reload.name":  "Reload resources",
    "config.the-nothing-mod.dev.reload.description":  "Same as F3+T: reloads models, blockstates and textures from disk.",
