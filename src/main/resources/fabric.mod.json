{
	"schemaVersion": 1,
	"id": "the-nothing-mod",
	"version": "${version}",
	"name": "The Nothing Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/the-nothing-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.realarqade.thenothingmod.fabric.TheNothingModFabric"
		],
		"client": [
			"com.realarqade.thenothingmod.client.fabric.TheNothingModClientFabric"
			],
			"modmenu": [
				"com.realarqade.thenothingmod.client.fabric.DustModMenuIntegration"
		]
	},
	"mixins": [
		"the-nothing-mod.mixins.json",
		{
			"config": "the-nothing-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}